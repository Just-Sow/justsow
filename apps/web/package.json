{
	"name": "@justsow/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm run typecheck",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:setup": "playwright install chromium chromium-headless-shell",
		"test:unit": "vitest run --project server",
		"test:browser": "vitest run --project client",
		"test:browser:ci": "vitest run --project client",
		"test": "pnpm run test:unit"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/simple-icons": "^1.2.97",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.47.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@vitest/browser": "^5.0.1",
		"@vitest/browser-playwright": "^5.0.1",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.1",
		"unplugin-icons": "^24.0.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@justsow/shared": "workspace:*",
		"@iconify-json/flagpack": "^1.2.8",
		"@iconify/svelte": "^5.2.2",
		"@portabletext/svelte": "^4.0.0",
		"@sanity/image-url": "^2.1.1",
		"@sanity/sveltekit": "^2.1.0",
		"libphonenumber-js": "^1.13.13",
		"maplibre-gl": "^6.11.1",
		"qrcode": "^1.5.4",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	}
}
