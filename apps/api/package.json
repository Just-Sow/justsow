{
  "name": "@justsow/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:prepare": "node --import tsx scripts/prepare-databases.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:test": "node --import tsx scripts/migrate-test-database.ts",
    "db:setup": "pnpm run db:prepare && pnpm run db:migrate && pnpm run db:migrate:test",
    "db:reset:dev": "node --import tsx scripts/reset-and-seed-dev-database.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/run-tests.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@fastify/rate-limit": "^11.2.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
