{
  "name": "justsow",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev --filter=@justsow/web --filter=@justsow/api",
    "dev:cms": "turbo run dev --filter=@justsow/web --filter=@justsow/api --filter=@justsow/studio",
    "studio:dev": "pnpm --filter @justsow/studio dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:setup": "pnpm --filter @justsow/web run test:setup",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:prepare": "pnpm --dir apps/api run db:prepare",
    "db:setup": "pnpm --dir apps/api run db:setup",
    "db:reset:dev": "pnpm --dir apps/api run db:reset:dev"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
